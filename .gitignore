# Document files
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx

# Font files
*.ttf
*.otf
*.woff
*.woff2

# Icon files
*.ico
*.svg

# Archive and compression
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
*.tgz
*.tbz2
*.txz
*.tzst

# Node modules (redundant but explicit)
node_modules/

# Distribution folder
dist/

# Build folder
build/
