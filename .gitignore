```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/

# SSH keys
.ssh/kachat_key
.ssh/kachat_key.pub

# Environment variables
.env

# Logs
*.log

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*.swo

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
.env

# Coverage reports
coverage/
htmlcov/

# Database
*.sqlite
*.sqlite3

# Compiled binary files
*.exe
*.dll
*.so
*.a
*.out

# Browserslist
.browserslist*

# ESLint
.eslintcache

# Supabase
.supabase/

# NPM
.npm/

# Yarn
.yarn/
.yarnrc

# Vite
.vite/

# Rolldown
.rolldown/

# Package lock files
package-lock.json
yarn.lock

# GitHub Pages
.gh-pages*

# Temporary build outputs
*.bundle.js
*.bundle.css
*.min.js
*.min.css

# Cache directories
.cache/
.tmp/
.temp/

# TypeScript
*.tsbuildinfo
*.tsx

# Map files
*.map

# Lock files
*.lock

# Configuration backups
*.bak
*.backup

# System files
*.sys
*.dll
*.drv

# Editor swap files
*~
.swp
.swo

# Log files
*.log
*.out
*.pid

# Process identifiers
*.pid

# Sensitive files
*.key
*.pem
*.crt
*.cert

# Local configuration
*.local
*.dev

# Development files
*.dev.js
*.dev.css

# Test files
*.test.js
*.spec.js
*.test.ts
*.spec.ts

# Backup files
*.bak
*.backup
*.orig

# Archive files
*.zip
*.rar
*.7z
*.tar
*.gz
*.bz2
*.xz
*.zst

# Image files (not ignored as per rule)
# *.png
# *.jpg
# *.jpeg
# *.bmp
# *.gif
# *.webm

# Video files
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.webm
*.mkv

